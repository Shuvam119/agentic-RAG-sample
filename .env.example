GROQ_API_KEY=
TAVILY_API_KEY=

# LLM used by the agent. llama-3.3-70b-versatile is NOT recommended: Groq's
# tool-calling for that model is unreliable with two bound tools.
# openai/gpt-oss-120b handles multi-tool calls correctly.
MODEL_NAME=openai/gpt-oss-120b

# Directory containing the raw documents indexed by this project.
# Defaults to this project's own data/raw folder.
DOCS_SOURCE=C:\Users\USER\agentic-rag\data\raw

# Relevance gate: a query is only answered from the knowledge base if its top
# hit is at least SIMILARITY_THRESHOLD similar AND beats the corpus mean by
# RELEVANCE_MARGIN. When the query names an indexed product (StreamCutPro,
# PolicyHub) only the relaxed PRODUCT_SIMILARITY_THRESHOLD applies, so
# questions about a product always stay in the knowledge base even when the
# product name matches a real-world product.
SIMILARITY_THRESHOLD=0.55
RELEVANCE_MARGIN=0.10
PRODUCT_SIMILARITY_THRESHOLD=0.50

# Embedding model and default number of chunks per search.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=4
