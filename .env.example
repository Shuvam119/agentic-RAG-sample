GROQ_API_KEY=
TAVILY_API_KEY=

# Directory containing the raw documents indexed by this project.
# Defaults to the Traditional RAG project's document folder because both
# projects share the same documents. This project builds its OWN index
# from these files and never modifies the Traditional RAG project.
DOCS_SOURCE=C:\Users\USER\ai-docs-copilot\data\raw

# Relevance gate: a query is only answered from the knowledge base if its top
# hit is at least SIMILARITY_THRESHOLD similar AND beats the corpus mean by
# RELEVANCE_MARGIN. Unrelated queries (e.g. general knowledge) return nothing.
SIMILARITY_THRESHOLD=0.55
RELEVANCE_MARGIN=0.10

# Embedding model and default number of chunks per search.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5
